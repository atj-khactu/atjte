# Copy to gateway.env (gitignored) and fill in. Read from THIS folder only.
# The Open API application (https://openapi.ctrader.com -> Applications).
ctrader_client_id =
ctrader_client_secret =
# OAuth tokens for the cTID that owns the account, "trading" scope. The
# gateway renews the access token with the refresh token when it expires and
# writes the NEW pair back into this file.
ctrader_access_token =
ctrader_refresh_token =
# The ctidTraderAccountId (the Open API's account id, NOT the login number).
ctrader_account_id =
# The loopback secret the bots present (put the same value in the workspace
# env/.env as ct_gateway_token).
ct_gateway_token =
