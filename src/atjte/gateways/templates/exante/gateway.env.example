# Copy to gateway.env (gitignored) and fill in. Read from THIS folder only.
# The EXANTE account this gateway trades (optional: the API key's first
# account with full rights is used when empty), e.g. ABC1234.001
exante_account_id =
# The HTTP API key (Client's Area → Settings → API Management): its
# Application ID and access key (Basic auth) ...
exante_application_id =
exante_access_key =
# ... or, for JWT auth instead of the access key:
# exante_client_id =
# exante_shared_key =
# The FIX passwords EXANTE's account manager issues — one per session
# (TRADE: orders, FEED: quotes). The CompIDs are <ACCOUNT>_TRADE[_UAT] and
# <ACCOUNT>_FEED[_UAT]; set trade_sender / feed_sender in gateway.json if
# EXANTE issued others.
exante_fix_trade_password =
exante_fix_feed_password =
# The loopback handshake secret the bots present (any long random string;
# put the same value in the workspace env/.env as ex_gateway_token).
ex_gateway_token =
