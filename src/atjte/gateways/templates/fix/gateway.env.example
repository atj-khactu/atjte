# Credentials for THIS gateway. Copy to gateway.env — which is gitignored,
# as is the whole gateways/ folder.
#
# This file is the ONLY place the gateway reads credentials from -- not the
# workspace's env/.env, not the process environment, and never the spot REST
# key pair. A gateway logs on as an account; every name below must be here.
#
# The gateway is the ONLY process that needs the venue key: bots hold a
# loopback token and nothing else, and the key never crosses the socket.

# The SenderCompID Kraken issued with this session. One logon per CompID —
# never point two gateways at the same one. A DERIVATIVES gateway (venue
# krakenfutures) takes the -DRV one Kraken issued for derivatives.
kraken_fix_sender=

# In UAT: a Spot API key with WebSocket permission. In production: a key of
# type FIX.
kraken_fix_key=
kraken_fix_secret=

# The account's REST key pair. The gateway serves every attached bot's reads
# (balance, positions, orders, trades), its prices and its fills with it over
# CCXT; the ORDERS stay on the FIX session. Spot: needs WebSocket permission.
# (A derivatives gateway, venue krakenfutures, names these kraken_fut_key /
# kraken_fut_secret -- atjte-gateway --new writes the right names.)
{rest_key}=
{rest_secret}=

# Shared secret a bot presents when attaching. Without it any process on
# this machine can attach and place orders on the account. The bots read the
# SAME name from the workspace's env/.env -- set it in both places.
kraken_fix_gateway_token=
