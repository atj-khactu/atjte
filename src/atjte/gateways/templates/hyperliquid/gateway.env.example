# Copy to gateway.env (gitignored) and fill in. Read from THIS folder only.
# The key that signs every action: an API wallet approved on the main account
# (Hyperliquid app -> API), or the main account's own key.
hyperliquid_private_key =
# The MAIN account's address (not the API wallet's).
hyperliquid_wallet_address =
# One per non-main account listed in gateway.json "accounts":
# hyperliquid_sub_account_sub1 = 0x...
# The loopback handshake secret the bots present (any long random string;
# put the same value in the workspace env/.env as hl_gateway_token).
hl_gateway_token =
