# Copy to gateway.env (gitignored) and fill in. Read from THIS folder only.
# Lighter's signing library (lighter-signer-<os>-<arch> from
# elliottech/lighter-python) — what lets an EXISTING API key sign.
lighter_library_path =
# Account 'main': its account index, the API key's slot (4..254) and that
# existing API private key (80 hex — NOT the L1 wallet key).
lighter_account_index =
lighter_api_key_index =
lighter_private_key =
# One set per other account listed in gateway.json "accounts", e.g. sub1:
# lighter_account_index_sub1 =
# lighter_api_key_index_sub1 =
# lighter_private_key_sub1 =
# The loopback handshake secret the bots present (any long random string;
# put the same value in the workspace env/.env as lt_gateway_token).
lt_gateway_token =
